# Gradle daemon memory settings - 성능 최적화
org.gradle.jvmargs=-Xmx4096m -Xms2048m -XX:MaxMetaspaceSize=1024m -XX:+HeapDumpOnOutOfMemoryError -XX:+UseG1GC -XX:+UseStringDeduplication
org.gradle.parallel=true
org.gradle.daemon=true
org.gradle.caching=true

# Runtime JVM settings for performance testing
systemProp.java.opts=-Xmx6g -Xms3g -XX:+UseG1GC -XX:+UseStringDeduplication -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+EnableJVMCI -XX:+UseJVMCICompiler

# Test memory settings
systemProp.junit.jupiter.execution.parallel.enabled=false