{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "🟢 클러스터 상태",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "RED 🔴" }, "1": { "text": "YELLOW 🟡" }, "2": { "text": "GREEN 🟢" } }, "type": "value" }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "elasticsearch_cluster_health_status{color=\"green\"} * 2 + elasticsearch_cluster_health_status{color=\"yellow\"}", "legendFormat": "상태", "instant": true }
      ],
      "options": { "colorMode": "background" }
    },
    {
      "title": "📊 샤드 / 노드",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "elasticsearch_cluster_health_active_shards", "legendFormat": "활성 샤드" },
        { "expr": "elasticsearch_cluster_health_number_of_nodes", "legendFormat": "노드 수" }
      ],
      "options": { "colorMode": "value" }
    },
    {
      "title": "⏳ 대기 작업",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "elasticsearch_cluster_health_number_of_pending_tasks", "legendFormat": "대기 작업", "instant": true }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "title": "📝 색인 처리량",
      "description": "초당 색인/삭제 작업 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "색인/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "삭제/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(elasticsearch_indices_indexing_index_total[1m])", "legendFormat": "색인/초" },
        { "expr": "rate(elasticsearch_indices_indexing_delete_total[1m])", "legendFormat": "삭제/초" }
      ]
    },
    {
      "title": "🔍 검색 처리량",
      "description": "초당 검색 쿼리/Fetch 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "쿼리/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Fetch/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(elasticsearch_indices_search_query_total[1m])", "legendFormat": "쿼리/초" },
        { "expr": "rate(elasticsearch_indices_search_fetch_total[1m])", "legendFormat": "Fetch/초" }
      ]
    },
    {
      "title": "⏱️ 검색 지연시간",
      "description": "검색 쿼리/Fetch 평균 소요시간 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(elasticsearch_indices_search_query_time_seconds_total[5m]) / rate(elasticsearch_indices_search_query_total[5m]) * 1000", "legendFormat": "쿼리 평균 (ms)" },
        { "expr": "rate(elasticsearch_indices_search_fetch_time_seconds_total[5m]) / rate(elasticsearch_indices_search_fetch_total[5m]) * 1000", "legendFormat": "Fetch 평균 (ms)" }
      ]
    },
    {
      "title": "💾 JVM 힙 메모리",
      "description": "ES JVM 힙 사용량 / 최대치",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "최대" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "elasticsearch_jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "사용 중" },
        { "expr": "elasticsearch_jvm_memory_max_bytes{area=\"heap\"}", "legendFormat": "최대" }
      ]
    },
    {
      "title": "💿 인덱스 저장 크기",
      "description": "전체 인덱스 데이터 크기",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "elasticsearch_indices_store_size_bytes_total", "legendFormat": "전체 크기" }
      ]
    },
    {
      "title": "📄 문서 수",
      "description": "전체 / 삭제된 문서 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "삭제됨" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "elasticsearch_indices_docs_total", "legendFormat": "전체 문서" },
        { "expr": "elasticsearch_indices_docs_deleted_total", "legendFormat": "삭제됨" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["elasticsearch", "검색"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "🔍 Elasticsearch - OnlyOne",
  "uid": "elasticsearch-onlyone",
  "version": 2
}
