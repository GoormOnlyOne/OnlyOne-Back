{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "🔐 JWT 인증 성공률",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(security_jwt_auth_total{result=\"success\"}[5m]) / (rate(security_jwt_auth_total{result=\"success\"}[5m]) + rate(security_jwt_auth_total{result=\"failure\"}[5m]) + 1e-10)", "legendFormat": "성공률" }
      ]
    },
    {
      "title": "🔐 JWT 인증 처리량",
      "description": "초당 JWT 인증 성공/실패/비활성 거부",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "성공/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "실패/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "비활성 거부/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(security_jwt_auth_total{result=\"success\"}[1m])", "legendFormat": "성공/초" },
        { "expr": "rate(security_jwt_auth_total{result=\"failure\"}[1m])", "legendFormat": "실패/초" },
        { "expr": "rate(security_jwt_inactive_rejected_total[1m])", "legendFormat": "비활성 거부/초" }
      ]
    },
    {
      "title": "🔌 STOMP 인증 성공률",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(security_stomp_auth_total{result=\"success\"}[5m]) / (rate(security_stomp_auth_total{result=\"success\"}[5m]) + rate(security_stomp_auth_total{result=\"failure\"}[5m]) + 1e-10)", "legendFormat": "성공률" }
      ]
    },
    {
      "title": "🔌 STOMP 인증 처리량",
      "description": "초당 STOMP 인증 성공/실패",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "성공/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "실패/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(security_stomp_auth_total{result=\"success\"}[1m])", "legendFormat": "성공/초" },
        { "expr": "rate(security_stomp_auth_total{result=\"failure\"}[1m])", "legendFormat": "실패/초" }
      ]
    },
    {
      "title": "📊 전체 인증 이벤트 (JWT + STOMP)",
      "description": "모든 인증 방식 합산 처리량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "전체 인증/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "전체 실패/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(security_jwt_auth_total[1m])) + sum(rate(security_stomp_auth_total[1m]))", "legendFormat": "전체 인증/초" },
        { "expr": "sum(rate(security_jwt_auth_total{result=\"failure\"}[1m])) + sum(rate(security_stomp_auth_total{result=\"failure\"}[1m]))", "legendFormat": "전체 실패/초" }
      ]
    },
    {
      "title": "🚫 비활성 사용자 거부 (누적)",
      "description": "비활성 사용자 JWT 인증 거부 누적 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } },
        "overrides": [{ "matcher": { "id": "byName", "options": "누적 거부" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }]
      },
      "targets": [
        { "expr": "security_jwt_inactive_rejected_total", "legendFormat": "누적 거부" }
      ]
    },
    {
      "title": "🛡️ HTTP 인증 오류 (401/403)",
      "description": "Spring Security에서 발생한 인증/권한 오류",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 15 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "401 인증실패/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "403 권한없음/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"onlyone\", status=\"401\"}[1m]))", "legendFormat": "401 인증실패/초" },
        { "expr": "sum(rate(http_server_requests_seconds_count{application=\"onlyone\", status=\"403\"}[1m]))", "legendFormat": "403 권한없음/초" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["보안", "jwt", "인증"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "🔐 보안 & 인증 - OnlyOne",
  "uid": "security-onlyone",
  "version": 2
}
