{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "💾 메모리 사용률",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "redis_memory_used_bytes / redis_memory_max_bytes", "legendFormat": "사용률" }
      ]
    },
    {
      "title": "🎯 캐시 적중률",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.9 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total + 1)", "legendFormat": "적중률", "instant": true }
      ]
    },
    {
      "title": "🔗 연결 클라이언트",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "redis_connected_clients", "legendFormat": "연결됨" }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "title": "⚡ 초당 명령 수",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10000 }, { "color": "red", "value": 50000 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "명령/초" }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "title": "💾 메모리 사용량 추이",
      "description": "사용 중 / 최대 / RSS 메모리",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "최대" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "사용 중" },
        { "expr": "redis_memory_max_bytes", "legendFormat": "최대" },
        { "expr": "redis_memory_used_rss_bytes", "legendFormat": "RSS" }
      ]
    },
    {
      "title": "⚡ 명령 유형별 처리량",
      "description": "주요 Redis 명령 초당 처리 횟수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "전체 명령/초" },
        { "expr": "irate(redis_commands_total{cmd=~\"get|set|del|hget|hset\"}[1m])", "legendFormat": "{{cmd}}/초" }
      ]
    },
    {
      "title": "🔗 클라이언트 연결 추이",
      "description": "연결된 / 차단된 클라이언트 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "차단됨" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "redis_connected_clients", "legendFormat": "연결됨" },
        { "expr": "redis_blocked_clients", "legendFormat": "차단됨" }
      ]
    },
    {
      "title": "🗑️ 키 만료 / 퇴거 추이",
      "description": "TTL 만료 및 메모리 부족으로 퇴거된 키",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "퇴거/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "만료/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(redis_evicted_keys_total[1m])", "legendFormat": "퇴거/초" },
        { "expr": "rate(redis_expired_keys_total[1m])", "legendFormat": "만료/초" }
      ]
    },
    {
      "title": "🔑 키스페이스 현황",
      "description": "DB별 저장된 키 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "redis_db_keys", "legendFormat": "db{{db}} 키" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["redis", "캐시"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "⚡ Redis - OnlyOne",
  "uid": "redis-onlyone",
  "version": 2
}
