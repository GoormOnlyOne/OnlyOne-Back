{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "🔗 연결 수",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 450 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "현재 연결" }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "title": "⚡ 초당 쿼리 수",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5000 }, { "color": "red", "value": 10000 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(mysql_global_status_queries[1m])", "legendFormat": "QPS" }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "title": "🐌 슬로우 쿼리/분",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "increase(mysql_global_status_slow_queries[1m])", "legendFormat": "슬로우 쿼리" }
      ],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "title": "🎯 버퍼풀 적중률",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.95 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "1 - (rate(mysql_global_status_innodb_buffer_pool_reads[5m]) / (rate(mysql_global_status_innodb_buffer_pool_read_requests[5m]) + 1))", "legendFormat": "적중률" }
      ]
    },
    {
      "title": "🔗 MySQL 연결 현황",
      "description": "연결됨 / 실행 중 / 최대 허용 연결 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "최대 허용" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "연결됨" },
        { "expr": "mysql_global_status_threads_running", "legendFormat": "실행 중" },
        { "expr": "mysql_global_variables_max_connections", "legendFormat": "최대 허용" }
      ]
    },
    {
      "title": "⚡ 쿼리 유형별 처리량 (QPS)",
      "description": "SELECT, INSERT, UPDATE, DELETE 초당 처리량",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SELECT/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "INSERT/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UPDATE/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "DELETE/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(mysql_global_status_queries[1m])", "legendFormat": "전체 QPS" },
        { "expr": "rate(mysql_global_status_commands_total{command=\"select\"}[1m])", "legendFormat": "SELECT/초" },
        { "expr": "rate(mysql_global_status_commands_total{command=\"insert\"}[1m])", "legendFormat": "INSERT/초" },
        { "expr": "rate(mysql_global_status_commands_total{command=\"update\"}[1m])", "legendFormat": "UPDATE/초" },
        { "expr": "rate(mysql_global_status_commands_total{command=\"delete\"}[1m])", "legendFormat": "DELETE/초" }
      ]
    },
    {
      "title": "🐌 슬로우 쿼리 추이",
      "description": "초당 슬로우 쿼리 발생 빈도",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } },
        "overrides": [{ "matcher": { "id": "byName", "options": "슬로우 쿼리/초" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }]
      },
      "targets": [
        { "expr": "rate(mysql_global_status_slow_queries[1m])", "legendFormat": "슬로우 쿼리/초" }
      ]
    },
    {
      "title": "🔒 InnoDB 행 잠금 대기",
      "description": "행 잠금 대기 횟수 및 현재 대기 수",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(mysql_global_status_innodb_row_lock_waits[1m])", "legendFormat": "잠금 대기/초" },
        { "expr": "mysql_global_status_innodb_row_lock_current_waits", "legendFormat": "현재 잠금 대기" }
      ]
    },
    {
      "title": "⏳ InnoDB 잠금 대기 시간",
      "description": "행 잠금으로 인한 대기 시간 (ms/초)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "fillOpacity": 15 } },
        "overrides": [{ "matcher": { "id": "byName", "options": "잠금 대기시간 (ms/초)" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }]
      },
      "targets": [
        { "expr": "rate(mysql_global_status_innodb_row_lock_time[1m])", "legendFormat": "잠금 대기시간 (ms/초)" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["mysql", "데이터베이스"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "🗄️ MySQL - OnlyOne",
  "uid": "mysql-onlyone",
  "version": 2
}
